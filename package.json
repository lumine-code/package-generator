{
  "name": "package-generator",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Generate ready-to-edit packages and syntax themes.",
  "keywords": [
    "scaffolding",
    "template",
    "development",
    "theme"
  ],
  "repository": "https://github.com/lumine-code/package-generator",
  "bugs": {
    "url": "https://github.com/lumine-code/package-generator/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "createInDevMode": {
      "title": "Link Generated Packages in Development Mode",
      "description": "Link generated packages in packages-dev instead of the normal packages directory.",
      "type": "boolean",
      "default": false
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
